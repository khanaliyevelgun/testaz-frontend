# Backend API base URL.
# Leave empty only when the backend is served from the same origin as the Next.js app.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Frontend-only auth mock. Server-side only; never exposed through NEXT_PUBLIC_*.
# Mock is ignored automatically when NODE_ENV=production.
AUTH_MOCK_ENABLED=false

# When true, mock login/register/refresh grant an authenticated session.
# Set false to test unauthorized and login-required flows.
AUTH_MOCK_GRANT_AUTH=true

# Role returned by the mock backend: admin, parent, or child.
AUTH_MOCK_ROLE=admin

# Optional error simulation: none, all, login, register, refresh, profile,
# forgot-password, or reset-password.
AUTH_MOCK_ERROR_MODE=none

AUTH_MOCK_USER_ID=mock-user-1
AUTH_MOCK_USER_NAME=Mock Admin
AUTH_MOCK_EMAIL=admin@example.com
